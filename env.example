# Copy to .env (gitignored). Defaults keep SQLite so `manage.py test` works offline.

SECRET_KEY=django-insecure-learning-key-recon-platform-2026
DEBUG=true
ALLOWED_HOSTS=*

# 1 = sqlite (tests / offline). 0 = compose Postgres.
USE_SQLITE=1
POSTGRES_DB=reconciliation
POSTGRES_USER=reconciliation
POSTGRES_PASSWORD=reconciliation
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# From the Mac: localhost. From another container: redis / kafka.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
