# Copy to .env (gitignored). Django loads this file in config/settings.py.
# Compose Postgres also reads POSTGRES_* from this file.
# manage.py test always uses SQLite even when USE_SQLITE=0.

# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_FERNET_KEY=
DEBUG=true
ALLOWED_HOSTS=*

# 1 = sqlite (tests / offline). 0 = compose Postgres.
USE_SQLITE=1
POSTGRES_DB=reconciliation
POSTGRES_USER=reconciliation
POSTGRES_PASSWORD=reconciliation
POSTGRES_HOST=localhost
# Compose publishes 5433; Homebrew Postgres often already owns 5432.
POSTGRES_PORT=5433

# From the Mac: 127.0.0.1 (avoid IPv6 localhost). From another container: redis / kafka.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_RECORD_INGESTED=record.ingested
KAFKA_ENABLED=true

# Connectors: extra allowed roots (merged with uploads/ and connector_data/).
# Example home folder (prefer a narrower path, e.g. .../ledger_exports):
# CONNECTOR_LOCAL_ALLOWLIST=/Users/you,/Users/you/Desktop/exports
# CONNECTOR_STAGING_ROOT=  # defaults to uploads/connector_fetch

# RAG (Phase 7): fake = offline dev/tests; sentence_transformers = pip install sentence-transformers
RAG_EMBEDDING_BACKEND=fake
# RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
